# Copy to .env and adjust. Every value is optional; these are the defaults.

# Interface and port the API listens on. 127.0.0.1 keeps it reachable from this machine only.
HOST=127.0.0.1
PORT=4000

# Comma-separated list of browser origins allowed to call the API with cookies.
CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Where users and sessions are stored (JSON file). Relative paths resolve from backend/.
DATA_FILE=data/db.json

# Session lifetimes. "Keep me signed in" uses REMEMBER_ME_DAYS, otherwise SESSION_HOURS.
SESSION_HOURS=24
REMEMBER_ME_DAYS=30

# How long a password reset link stays valid.
RESET_TOKEN_MINUTES=30

# Set to true only when running behind a reverse proxy that sets X-Forwarded-For.
TRUST_PROXY=false
